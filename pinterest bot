# --- АВТОПОДКЛЮЧЕНИЕ FFMPEG / FFPROBE ---
def setup_ffmpeg() -> None:
    if shutil.which("ffmpeg") and shutil.which("ffprobe"):
        return

    try:
        logger.info("ffmpeg/ffprobe не найдены в PATH. Подключаю через static-ffmpeg...")
        static_ffmpeg.add_paths()
    except Exception:
        logger.warning("Не удалось инициализировать static-ffmpeg", exc_info=True)

    if shutil.which("ffmpeg") and shutil.which("ffprobe"):
        logger.info("ffmpeg и ffprobe успешно подключены через static-ffmpeg!")
        return

    try:
        exe = Path(imageio_ffmpeg.get_ffmpeg_exe())
        if exe.is_file():
            bin_dir = BASE_DIR / "ffmpeg_bin"
            bin_dir.mkdir(parents=True, exist_ok=True)
            target_name = "ffmpeg.exe" if os.name == "nt" else "ffmpeg"
            target_path = bin_dir / target_name
            if not target_path.exists():
                try:
                    os.symlink(exe, target_path)
                except OSError:
                    shutil.copy2(exe, target_path)
            os.environ["PATH"] = str(bin_dir) + os.pathsep + os.environ.get("PATH", "")
            logger.info("ffmpeg подключён через imageio-ffmpeg: %s", target_path)
    except Exception:
        logger.warning("Не удалось подключить imageio-ffmpeg", exc_info=True)

    if not shutil.which("ffmpeg"):
        logger.warning(
            "ffmpeg всё ещё недоступен — бот будет скачивать оригинальное аудио без перекодирования."
        )


