def load_users() -> set[int]:
    try:
        if USERS_FILE.exists():
            data = json.loads(USERS_FILE.read_text(encoding="utf-8"))
            return {int(x) for x in data}
    except Exception:
        logger.exception("Не удалось прочитать users.json")
    return set()

users_db: set[int] = load_users()

def save_users() -> None:
    temp_file = USERS_FILE.with_suffix(".json.tmp")
    temp_file.write_text(json.dumps(sorted(users_db), ensure_ascii=False), encoding="utf-8")
    temp_file.replace(USERS_FILE)

