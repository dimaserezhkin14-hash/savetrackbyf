def _is_audio_document(doc: types.Document | None) -> bool:
    if not doc:
        return False
    mime = (doc.mime_type or "").lower()
    if mime.startswith("audio/"):
        return True
    ext = Path(doc.file_name or "").suffix.lower()
    return ext in SUPPORTED_AUDIO_EXTS

@dp.message(F.audio | F.document.func(_is_audio_document))
async def handle_user_audio_for_editor(message: types.Message, state: FSMContext):
    if message.chat.id == LOG_GROUP_ID:
        return

    user = message.from_user
    register_user(user.id, username=user.username)
    await state.clear()
    cleanup_audio_edit_session(user.id)

    media = message.audio or message.document
    if media.file_size and media.file_size > TG_VIDEO_DL_LIMIT:
        return await message.reply(
            "⚠️ <b>Файл слишком большой!</b>\n"
            "Telegram разрешает ботам принимать файлы размером до <b>20 МБ</b>.\n"
            "Если это тяжелый WAV-файл, попробуй сжать его или отправь файл до 20 МБ.",
            parse_mode="HTML",
        )

    wait_msg = await message.reply("⏳ Загружаю аудио в редактор тегов и обложки...")
    uid_tag = f"edit_{user.id}_{uuid.uuid4().hex[:8]}"

    orig_filename = getattr(media, "file_name", "") or ""
    ext = Path(orig_filename).suffix.lower()
    if not ext:
        ext = ".mp3" if message.audio else ".wav"

    src_path = DOWNLOAD_DIR / f"{uid_tag}{ext}"
    cov_path = DOWNLOAD_DIR / f"{uid_tag}_cover.jpg"

    try:
        await bot.download(media, destination=src_path)

        tg_thumb = getattr(media, "thumbnail", None)
        extracted_cov: Path | None = None
        if tg_thumb:
            raw_tg_thumb = DOWNLOAD_DIR / f"{uid_tag}_tgthumb.jpg"
            try:
                await bot.download(tg_thumb, destination=raw_tg_thumb)
                extracted_cov = await asyncio.to_thread(prepare_thumbnail, raw_tg_thumb, cov_path, 600)
            except Exception:
                pass
            finally:
                if raw_tg_thumb.exists():
                    try:
                        raw_tg_thumb.unlink()
                    except OSError:
                        pass

        pr_title, pr_artist, pr_dur, ff_cov = await asyncio.to_thread(
            probe_audio_metadata,
            src_path,
            None if extracted_cov else cov_path,
        )
        final_cov = extracted_cov or ff_cov

        tg_title = _clean_text(getattr(media, "title", "") or "")
        tg_artist = _clean_artist(getattr(media, "performer", "") or "")
        stem_clean = _clean_text(Path(orig_filename).stem) if orig_filename else ""

        raw_title = tg_title or pr_title or stem_clean or "Без названия"
        raw_artist = tg_artist or pr_artist or ""

        if not raw_artist and stem_clean:
            s_art, s_tit = _split_artist_title(stem_clean)
            if s_art and s_tit:
                raw_artist = s_art
                if raw_title == stem_clean:
                    raw_title = s_tit

        if not raw_artist:
            raw_artist = user.first_name or "Неизвестен"

        dur = getattr(media, "duration", None) or pr_dur

        sess = AudioEditSession(
            user_id=user.id,
            chat_id=message.chat.id,
            source_path=src_path,
            source_ext=ext,
            title=raw_title[:64],
            artist=raw_artist[:64],
            duration=dur,
            cover_path=final_cov,
        )
        audio_edit_sessions[user.id] = sess
        await state.set_state(AudioEditStates.editing)

        try:
            await wait_msg.delete()
        except Exception:
            pass

        await render_editor_panel(sess)
    except Exception as exc:
        logger.warning("Ошибка открытия редактора аудио: %s", exc, exc_info=True)
        cleanup_audio_edit_session(user.id)
        await wait_msg.edit_text("❌ Не удалось прочитать этот аудиофайл. Убедись, что файл не повреждён.")


