@dp.message(F.voice)
async def handle_voice_shazam(message: types.Message, state: FSMContext):
    if message.chat.id == LOG_GROUP_ID:
        return

    user = message.from_user
    register_user(user.id, username=user.username)
    await state.clear()

    voice = message.voice
    if voice.file_size and voice.file_size > TG_VIDEO_DL_LIMIT:
        return await message.reply("⚠️ Голосовое сообщение слишком большое (лимит до 20 МБ).")

    status_msg = await message.reply(
        "🎧 <b>Слушаю голосовое...</b>\n"
        "<i>Анализирую мелодию, ритм, вокал и сигнатуру трека (Shazam + AI)...</i>",
        parse_mode="HTML",
    )
    uid_tag = f"vshz_{user.id}_{uuid.uuid4().hex[:8]}"
    ogg_path = DOWNLOAD_DIR / f"{uid_tag}.ogg"

    try:
        await bot.download(voice, destination=ogg_path)
        hint, candidates, sung_text = await recognize_audio_smart(ogg_path)

        if hint and hint.title:
            method_line = f" ({hint.method})" if hint.method else ""
            await status_msg.edit_text(
                f"🎉 <b>Трек распознан{html.escape(method_line)}!</b>\n"
                f"🎵 <b>{html.escape(hint.search_query)}</b>\n\n"
                f"⏳ <i>Загружаю полную студийную версию в MP3...</i>",
                parse_mode="HTML",
            )
            target_q = hint.direct_urls[0] if hint.direct_urls else f"ytsearch1:{hint.search_query}"
            await download_and_send_single(message, user, target_q, status_msg=status_msg, hint=hint)

            # Если дополнительно нашлись похожие варианты по напетым словам — даём кнопки на выбор
            if candidates and len(candidates) > 1:
                session_id = uuid.uuid4().hex[:10]
                search_sessions[session_id] = {
                    "user_id": user.id,
                    "query": sung_text or hint.search_query,
                    "items": candidates,
                    "created_at": time.time(),
                }
                await message.answer(
                    f"🎶 Другие похожие версии по твоему напеву <b>«{html.escape(sung_text or hint.search_query)}»</b>:",
                    parse_mode="HTML",
                    reply_markup=build_search_keyboard(session_id, page=0),
                )
            await send_log(
                f"🎤 <b>Распознано ГС ({html.escape(hint.method or 'Shazam')}):</b> {html.escape(hint.search_query)}\n"
                f"• Юзер: @{user.username or 'нет'} (<code>{user.id}</code>)"
            )
            return

        # Если песня не угадана — предлагаем открыть само голосовое в редакторе MP3/обложек
        cleanup_audio_edit_session(user.id)
        edit_src = DOWNLOAD_DIR / f"edit_{user.id}_{uuid.uuid4().hex[:6]}.ogg"
        shutil.copy2(ogg_path, edit_src)
        sess = AudioEditSession(
            user_id=user.id,
            chat_id=message.chat.id,
            source_path=edit_src,
            source_ext=".ogg",
            title="Голосовое сообщение",
            artist=user.first_name or "Автор",
            duration=voice.duration,
        )
        audio_edit_sessions[user.id] = sess
        await state.set_state(AudioEditStates.editing)

        kb = InlineKeyboardBuilder()
        kb.row(types.InlineKeyboardButton(text="🎛 Сделать MP3 из этого ГС (Редактор)", callback_data="ed:open_from_voice"))
        await status_msg.edit_text(
            "😔 <b>Не удалось точно угадать песню по этому голосовому.</b>\n\n"
            "💡 <b>Как повысить точность до 100%:</b>\n"
            "• Напой мелодию чуть громче и длиннее (7–12 секунд) или проговори пару строчек из припева;\n"
            "• Либо просто напиши мне любые слова из песни текстом!\n\n"
            "👇 <i>А если ты хотел сконвертировать само это голосовое в MP3 и поставить обложку — нажми кнопку ниже:</i>",
            parse_mode="HTML",
            reply_markup=kb.as_markup(),
        )
    except Exception as exc:
        logger.warning("Ошибка распознавания голосового: %s", exc, exc_info=True)
        await status_msg.edit_text("❌ Произошла ошибка при анализе голосового сообщения.")
    finally:
        if ogg_path.exists():
            try:
                ogg_path.unlink()
            except OSError:
                pass


