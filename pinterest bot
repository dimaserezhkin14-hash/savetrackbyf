@dp.inline_query()
async def handle_inline_query(inline_query: types.InlineQuery):
    user = inline_query.from_user
    register_user(user.id, username=user.username)
    query = _clean_text(inline_query.query or "")

    if len(query) < 2:
        results = []
        cached_items = sorted(inline_audio_cache.items(), key=lambda x: x[1].get("ts", 0), reverse=True)[:15]
        for vid_id, data in cached_items:
            results.append(
                types.InlineQueryResultCachedAudio(
                    id=f"cached_{vid_id}",
                    audio_file_id=data["file_id"],
                    caption=get_mp3_caption(user.id),
                    parse_mode="HTML",
                )
            )
        return await inline_query.answer(
            results=results,
            cache_time=5,
            is_personal=True,
            button=types.InlineQueryResultsButton(
                text="🔎 Введи название песни после @юза...",
                start_parameter="inline_help",
            ),
        )

    found = await asyncio.to_thread(ytdlp_search_tracks, query, 10)
    results = []

    for item in found:
        vid_id = item.get("id")
        if not vid_id:
            continue
        title = item.get("title") or "Трек"
        artist = item.get("uploader") or "Музыка"
        dur = item.get("duration")
        dur_str = format_duration(dur)

        if vid_id in inline_audio_cache and inline_audio_cache[vid_id].get("file_id"):
            results.append(
                types.InlineQueryResultCachedAudio(
                    id=f"cached_{vid_id}",
                    audio_file_id=inline_audio_cache[vid_id]["file_id"],
                    caption=get_mp3_caption(user.id),
                    parse_mode="HTML",
                )
            )
        else:
            kb = InlineKeyboardBuilder()
            kb.add(types.InlineKeyboardButton(text="⏳ Загружаю MP3...", callback_data="inline_loading"))
            desc = f"{artist} • {dur_str}" if dur_str else artist
            results.append(
                types.InlineQueryResultArticle(
                    id=f"yt_{vid_id}",
                    title=f"🎵 {title}",
                    description=desc,
                    thumbnail_url=f"https://i.ytimg.com/vi/{vid_id}/hqdefault.jpg",
                    input_message_content=types.InputTextMessageContent(
                        message_text=f"⏳ <b>Загружаю трек:</b> {html.escape(artist)} — {html.escape(title)}...",
                        parse_mode="HTML",
                    ),
                    reply_markup=kb.as_markup(),
                )
            )

    await inline_query.answer(results=results, cache_time=15, is_personal=True)

@dp.chosen_inline_result()
async def handle_chosen_inline_result(chosen: types.ChosenInlineResult):
    if not chosen.result_id.startswith("yt_") or not chosen.inline_message_id:
        return

    vid_id = chosen.result_id[3:]
    user = chosen.from_user
    url = f"https://www.youtube.com/watch?v={vid_id}"
    uid_tag = f"inl_{user.id}_{uuid.uuid4().hex[:6]}"
    out_base = DOWNLOAD_DIR / f"track_{uid_tag}"
    audio_path: Path | None = None
    thumb_path: Path | None = None
    bitrate = get_user_bitrate(user.id)

    try:
        async with download_semaphore:
            audio_path, title, artist, dur, thumb_path, _ = await asyncio.to_thread(
                ytdlp_download_audio,
                url,
                out_base,
                bitrate,
                None,
            )

        safe_filename = re.sub(r'[\\/*?:"<>|]', "", f"{artist} - {title}")[:80].strip() or "track"
        storage_msg = await bot.send_audio(
            chat_id=LOG_GROUP_ID,
            audio=types.FSInputFile(audio_path, filename=f"{safe_filename}.mp3"),
            title=title[:64],
            performer=artist[:64],
            duration=dur,
            thumbnail=types.FSInputFile(thumb_path) if thumb_path else None,
            caption=(
                f"⚡ <b>Инлайн-отправка ({bitrate} kbps):</b> {html.escape(artist)} — {html.escape(title)}\n"
                f"• Юзер: @{user.username or 'нет'} (<code>{user.id}</code>)"
            ),
            parse_mode="HTML",
        )

        if storage_msg.audio and storage_msg.audio.file_id:
            file_id = storage_msg.audio.file_id
            cache_track_file_id(vid_id, file_id, title, artist, dur)

            await bot.edit_message_media(
                inline_message_id=chosen.inline_message_id,
                media=types.InputMediaAudio(
                    media=file_id,
                    title=title[:64],
                    performer=artist[:64],
                    duration=dur,
                    caption=get_mp3_caption(user.id),
                    parse_mode="HTML",
                ),
                reply_markup=None,
            )
    except Exception as exc:
        logger.warning("Ошибка инлайн-скачивания %s: %s", vid_id, exc, exc_info=True)
        try:
            await bot.edit_message_text(
                inline_message_id=chosen.inline_message_id,
                text=f"❌ Не удалось загрузить этот трек. Попробуй найти другую версию через @{BOT_USERNAME}",
                reply_markup=None,
            )
        except Exception:
            pass
    finally:
        for p in (audio_path, thumb_path):
            if p and p.exists():
                try:
                    p.unlink()
                except OSError:
                    pass

