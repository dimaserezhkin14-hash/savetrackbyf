# --- КЭШ ПОИСКА И ПАГИНАЦИЯ ---
search_sessions: dict[str, dict] = {}
shazam_quick_cache: dict[str, MetadataHint] = {}

def build_search_keyboard(session_id: str, page: int = 0) -> types.InlineKeyboardMarkup:
    sess = search_sessions.get(session_id) or {}
    items: list[dict] = sess.get("items") or []
    total = len(items)
    start = page * RESULTS_PER_PAGE
    end = min(start + RESULTS_PER_PAGE, total)

    kb = InlineKeyboardBuilder()
    for idx in range(start, end):
        item = items[idx]
        dur_str = format_duration(item.get("duration"))
        prefix = f"[{dur_str}] " if dur_str else "🎵 "
        label = f"{prefix}{item.get('title', 'Трек')}"
        if item.get("uploader") and item["uploader"].lower() not in label.lower():
            label = f"{prefix}{item['uploader']} — {item.get('title', 'Трек')}"
        kb.row(types.InlineKeyboardButton(text=label[:60], callback_data=f"dl:{session_id}:{idx}"))

    nav_buttons = []
    if page > 0:
        nav_buttons.append(types.InlineKeyboardButton(text="⬅️ Назад", callback_data=f"page:{session_id}:{page - 1}"))
    if end < total:
        nav_buttons.append(types.InlineKeyboardButton(text="Вперёд ➡️", callback_data=f"page:{session_id}:{page + 1}"))
    if nav_buttons:
        kb.row(*nav_buttons)

    return kb.as_markup()


