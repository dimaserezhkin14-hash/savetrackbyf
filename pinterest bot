        await render_editor_panel(
            sess,
            prompt_note="👤 <b>Введи нового автора (исполнителя)</b> и отправь его в чат:",
        )
    elif action == "cover":
        await state.set_state(AudioEditStates.waiting_cover)
        await call.answer()
        await render_editor_panel(
            sess,
            prompt_note="🖼 <b>Отправь картинку или фото</b> в чат, чтобы установить обложку:",
        )
    elif action == "del_cover":
        if sess.cover_path and sess.cover_path.exists():
            try:
                sess.cover_path.unlink()
            except OSError:
                pass
        sess.cover_path = None
        await state.set_state(AudioEditStates.editing)
        await call.answer("🗑 Обложка удалена!")
        await render_editor_panel(sess, prompt_note="✅ <i>Обложка удалена!</i>")
    elif action == "save":
        await state.clear()
        await call.answer("⏳ Собираю MP3 с новыми тегами...")
        try:
            await call.message.delete()
        except Exception:
            pass

