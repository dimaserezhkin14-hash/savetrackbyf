def _ensure_ref_record(user_id: int, username: str | None = None) -> dict:
    key = str(user_id)
    if key not in referrals_db or not isinstance(referrals_db[key], dict):
        referrals_db[key] = {"invited": [], "referred_by": None, "username": "", "is_pro": False}
    if not isinstance(referrals_db[key].get("invited"), list):
        referrals_db[key]["invited"] = []
    if "is_pro" not in referrals_db[key]:
        referrals_db[key]["is_pro"] = False
    if username:
        clean_uname = username.lstrip("@").lower()
        if referrals_db[key].get("username") != clean_uname:
            referrals_db[key]["username"] = clean_uname
            save_referrals()
    return referrals_db[key]

def get_invited_count(user_id: int) -> int:
    rec = referrals_db.get(str(user_id))
    if not isinstance(rec, dict):
        return 0
    return len(rec.get("invited") or [])

def is_pro_user(user_id: int) -> bool:
    rec = referrals_db.get(str(user_id))
    if isinstance(rec, dict) and rec.get("is_pro"):
        return True
    return get_invited_count(user_id) >= PRO_REQUIRED_REFS

async def set_manual_pro_async(target: str, status: bool) -> tuple[bool, int | None]:
    """Выдача или снятие фулл-прав (PRO) по ID или @username (с автопробивом через get_chat)."""
    clean = target.strip().lstrip("@").lower()
    if not clean:
        return False, None

    if clean.isdigit():
        uid = int(clean)
        users_db.add(uid)
        save_users()
        rec = _ensure_ref_record(uid)
        rec["is_pro"] = status
        save_referrals()
        return True, uid

    for uid_str, data in referrals_db.items():
        if isinstance(data, dict) and data.get("username", "").lower() == clean:
            data["is_pro"] = status
            save_referrals()
            return True, int(uid_str)

    try:
        chat = await bot.get_chat(f"@{clean}")
        if chat and chat.id > 0:
            uid = int(chat.id)
            users_db.add(uid)
            save_users()
            rec = _ensure_ref_record(uid, username=clean)
            rec["is_pro"] = status
            save_referrals()
            return True, uid
    except Exception:
        pass

    return False, None

