def _prepare_recognition_clips(media_path: Path, base_tag: str) -> list[tuple[str, Path]]:
    """
    Генерирует 4 специальных аудио-среза через FFmpeg для максимального шанса распознавания:
    1. Чистый центральный срез (оригинал).
    2. Изоляция вокала и мелодии (Highpass 200Hz + Lowpass 4200Hz + компрессия динамики).
    3. Анти-SpeedUp (замедление 0.84x для распознавания ускоренных TikTok-ремиксов).
    4. Анти-Slowed (ускорение 1.18x для распознавания slowed + reverb версий).
    """
    clips: list[tuple[str, Path]] = []
    if not shutil.which("ffmpeg"):
        return [("original", media_path)]

    # Узнаем длительность, чтобы брать сочную середину трека/видео, а не пустое интро
    _, _, dur, _ = probe_audio_metadata(media_path)
    start_sec = 0
    if dur and dur > 18:
        start_sec = min(int(dur * 0.25), 30)

    configs = [
        ("Shazam (Точный сигнал)", "anull", f"{base_tag}_std.wav"),
        ("Shazam (Выделение мелодии/голоса)", "highpass=f=200,lowpass=f=4200,dynaudnorm", f"{base_tag}_mel.wav"),
        ("Shazam (Анти-SpeedUp 0.84x)", "asetrate=16000*0.84,aresample=16000,dynaudnorm", f"{base_tag}_desped.wav"),
        ("Shazam (Анти-Slowed 1.18x)", "asetrate=16000*1.18,aresample=16000,dynaudnorm", f"{base_tag}_deslow.wav"),
    ]

    for label, af_filter, fname in configs:
        out_p = DOWNLOAD_DIR / fname
        cmd = [
            "ffmpeg", "-y",
            "-ss", str(start_sec),
            "-t", "14",
            "-i", str(media_path),
            "-vn", "-ac", "1", "-ar", "16000",
            "-af", af_filter,
            str(out_p),
        ]
        try:
            subprocess.run(cmd, capture_output=True, timeout=15)
            if out_p.exists() and out_p.stat().st_size > 1000:
                clips.append((label, out_p))
        except Exception:
            pass

    if not clips:
        clips.append(("Shazam", media_path))
    return clips

def _recognize_lyrics_via_stt(wav_path: Path) -> str:
    """Распознает напетые слова (RU + EN) из голосового/аудио через Google Speech Recognition."""
    recognizer = sr.Recognizer()
    try:
        with sr.AudioFile(str(wav_path)) as source:
            audio_data = recognizer.record(source, duration=14)
        for lang in ("ru-RU", "en-US"):
            try:
                text = recognizer.recognize_google(audio_data, language=lang)
                cleaned = _clean_text(text)
                if len(cleaned) >= 4:
                    return cleaned
            except Exception:
                continue
    except Exception:
        pass
    return ""

def _recognize_humming_via_acrcloud(wav_path: Path) -> MetadataHint | None:
    """Распознавание напевания (Humming) через ACRCloud, если заданы ключи ACR_*."""
    if not (ACR_HOST and ACR_ACCESS_KEY and ACR_SECRET_KEY):
        return None
    try:
        http_method = "POST"
        http_uri = "/v1/identify"
        data_type = "audio"
        signature_version = "1"
        timestamp = str(int(time.time()))
        string_to_sign = f"{http_method}\n{http_uri}\n{ACR_ACCESS_KEY}\n{data_type}\n{signature_version}\n{timestamp}"
        sign = base64.b64encode(
            hmac.new(ACR_SECRET_KEY.encode("utf-8"), string_to_sign.encode("utf-8"), digestmod=hashlib.sha1).digest()
        ).decode("utf-8")

        sample_bytes = wav_path.read_bytes()
        boundary = f"----BotBoundary{uuid.uuid4().hex}"
        fields = {
            "access_key": ACR_ACCESS_KEY,
            "sample_bytes": str(len(sample_bytes)),
            "timestamp": timestamp,
            "signature": sign,
            "data_type": data_type,
            "signature_version": signature_version,
        }
        body = bytearray()
        for k, v in fields.items():
            body.extend(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n".encode("utf-8"))
        body.extend(
            f"--{boundary}\r\nContent-Disposition: form-data; name=\"sample\"; filename=\"sample.wav\"\r\nContent-Type: application/octet-stream\r\n\r\n".encode("utf-8")
        )
        body.extend(sample_bytes)
        body.extend(f"\r\n--{boundary}--\r\n".encode("utf-8"))

        url = f"https://{ACR_HOST}{http_uri}"
        _, resp_text = _http_get_text(
            url,
            extra_headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
            post_data=bytes(body),
            timeout=12,
        )
        data = json.loads(resp_text)
        meta = data.get("metadata") or {}
        music_list = meta.get("humming") or meta.get("music") or []
        if music_list and isinstance(music_list[0], dict):
            top = music_list[0]
            title = _clean_text(top.get("title") or "")
            artists = top.get("artists") or []
            artist = _clean_artist(artists[0].get("name") or "") if artists else ""
            if title:
                return _enrich_hint_from_catalogs(MetadataHint(title=title, artist=artist, method="Humming AI (Напев/Мелодия)"))
    except Exception:
        logger.debug("Ошибка ACRCloud Humming", exc_info=True)
    return None

def _recognize_melody_via_gemini(wav_path: Path) -> MetadataHint | None:
    """Мультимодальное ИИ-распознавание напева, прогрессии, ритма или слов через Gemini API (если задан GEMINI_API_KEY)."""
    if not GEMINI_API_KEY:
        return None
    try:
        b64_audio = base64.b64encode(wav_path.read_bytes()).decode("ascii")
        api_url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={GEMINI_API_KEY}"
        payload = {
            "contents": [{
                "parts": [
                    {
                        "text": (
                            "Listen carefully to this audio clip. It may be a song recording, a sped-up/slowed remix, "
                            "or a person humming, singing, whistling, or beatboxing a melody/rhythm. "
                            "Identify the most likely song and return ONLY valid JSON: "
                            "{\"artist\": \"Artist Name\", \"title\": \"Song Title\"}. "
                            "If completely unrecognizable, return {\"artist\": \"\", \"title\": \"\"}."
                        )
                    },
                    {"inline_data": {"mime_type": "audio/wav", "data": b64_audio}},
                ]
            }]
        }
        _, resp_text = _http_get_text(
            api_url,
            extra_headers={"Content-Type": "application/json"},
            post_data=json.dumps(payload).encode("utf-8"),
            timeout=15,
        )
        resp_json = json.loads(resp_text)
        cand_text = (
            resp_json.get("candidates", [{}])[0]
            .get("content", {})
            .get("parts", [{}])[0]
            .get("text", "")
        )
        m = re.search(r"\{.*?\}", cand_text, re.S)
        if m:
            parsed = json.loads(m.group(0))
            t = _clean_text(parsed.get("title") or "")
            a = _clean_artist(parsed.get("artist") or "")
            if t and not _is_garbage_text(t):
                return _enrich_hint_from_catalogs(MetadataHint(title=t, artist=a, method="AI Melody & Rhythm"))
    except Exception:
        logger.debug("Ошибка Gemini Audio Recognition", exc_info=True)
    return None

async def recognize_audio_smart(media_path: Path) -> tuple[MetadataHint | None, list[dict], str]:
    """
    Главная функция распознавания песни по видео, аудио или голосовому (включая напевание/ритм/speedup).
    Возвращает: (точный_хинт, список_похожих_треков, распознанная_фраза).
    """
    base_tag = f"shz_{uuid.uuid4().hex[:8]}"
    clips = await asyncio.to_thread(_prepare_recognition_clips, media_path, base_tag)

    try:
        # 1. Прогоняем все 4 сигнатуры через Shazam (оригинал, вокал/мелодия, анти-speedup, анти-slowed)
        for method_label, clip_path in clips:
            try:
                res = await shazam_client.recognize(str(clip_path))
                track = (res or {}).get("track")
                if isinstance(track, dict) and track.get("title"):
                    raw_t = _clean_text(track.get("title") or "")
                    raw_a = _clean_artist(track.get("subtitle") or "")
                    images = track.get("images") or {}
                    cover = images.get("coverarthq") or images.get("coverart") or images.get("background")
                    if raw_t and not _is_garbage_text(raw_t):
                        hint = MetadataHint(title=raw_t, artist=raw_a, thumbnail_url=cover, method=method_label)
                        hint = await asyncio.to_thread(_enrich_hint_from_catalogs, hint)
                        return hint, [], ""
            except Exception:
                logger.debug("Попытка Shazam (%s) не дала результата", method_label)

        # Берём вокально-мелодический срез для Humming AI и распознавания напетых слов
        mel_clip = clips[1][1] if len(clips) > 1 else clips[0][1]

        # 2. Пробуем ACRCloud Humming (если подключен)
        acr_hint = await asyncio.to_thread(_recognize_humming_via_acrcloud, mel_clip)
        if acr_hint:
            return acr_hint, [], ""

        # 3. Пробуем мультимодальный ИИ-слух Gemini (мелодия, прогрессия, мычание, бит)
        ai_hint = await asyncio.to_thread(_recognize_melody_via_gemini, mel_clip)
        if ai_hint:
            return ai_hint, [], ""

        # 4. Распознаём напетые слова/строчки через Speech-to-Text (RU / EN) и ищем трек по тексту
        sung_words = await asyncio.to_thread(_recognize_lyrics_via_stt, mel_clip)
        if sung_words:
            # Сначала ищем точное совпадение в музыкальных каталогах Deezer / iTunes
            catalog_hits = await asyncio.to_thread(_search_deezer_catalog, sung_words, 5)
            if not catalog_hits:
                catalog_hits = await asyncio.to_thread(_search_itunes_catalog, sung_words, 5, "RU")

            yt_candidates = await asyncio.to_thread(ytdlp_search_tracks, f"{sung_words} песня трек", 12)
            if catalog_hits:
                best = catalog_hits[0]
                best.method = f"По напетым словам («{sung_words}»)"
                return best, yt_candidates, sung_words
            if yt_candidates:
                top_yt = yt_candidates[0]
                hint = MetadataHint(
                    title=top_yt.get("title") or "Трек",
                    artist=top_yt.get("uploader") or "",
                    duration=top_yt.get("duration"),
                    direct_urls=[top_yt["url"]],
                    method=f"По напетым словам («{sung_words}»)",
                )
                return hint, yt_candidates, sung_words

        return None, [], ""
    finally:
        for _, cp in clips:
            if cp != media_path and cp.exists():
                try:
                    cp.unlink()
                except OSError:
                    pass


# --- ИЗВЛЕЧЕНИЕ МЕТАДАННЫХ ИЗ СООБЩЕНИЯ ИЛИ ПРЕВЬЮ TELEGRAM ---
def extract_message_context_hint(message: types.Message, clean_url: str) -> MetadataHint | None:
    raw_msg = (message.text or message.caption or "").strip()
    if raw_msg:
        text_without_urls = URL_RE.sub(" ", raw_msg).strip(" \n\r\t—–-|•·,.")
        if text_without_urls and len(text_without_urls) >= 2 and not _is_garbage_text(text_without_urls):
            art, tit = _split_artist_title(text_without_urls)
            if art and tit:
                return MetadataHint(title=tit, artist=art)
            return MetadataHint(title=_clean_text(text_without_urls))
    return None


# --- ПАРСИНГ АЛЬБОМОВ И ТРЕКОВ (APPLE MUSIC, SPOTIFY, ЯНДЕКС, DEEZER) ---
def is_album_or_playlist_url(url: str, platform: str) -> bool:
    parsed = urlparse(url)
    path = (parsed.path or "").lower()
    query = parse_qs(parsed.query)
    if platform == "yandex":
        return "/album/" in path and "/track/" not in path
    if platform == "spotify":
        return "/album/" in path or "/playlist/" in path
    if platform == "apple":
        return ("/album/" in path and "i=" not in parsed.query) or "/playlist/" in path
    if platform == "deezer":
        return "/album/" in path or "/playlist/" in path
    if platform == "soundcloud":
        return "/sets/" in path
    if platform == "youtube":
        return "list" in query and "/watch" not in path
    return False

def extract_album_tracks(url: str, platform: str) -> tuple[str, list[MetadataHint]]:
    parsed = urlparse(url)
    path = parsed.path or ""

    if platform == "deezer":
        m = re.search(r"/(album|playlist)/(\d+)", path)
        if m:
            kind, item_id = m.group(1), m.group(2)
            try:
                _, text = _http_get_text(f"https://api.deezer.com/{kind}/{item_id}", timeout=10)
                data = json.loads(text)
                alb_title = _clean_text(data.get("title") or "Альбом")
                cover = data.get("cover_xl") or data.get("cover_big") or data.get("picture_xl")
                tracks_raw = (data.get("tracks") or {}).get("data") or []
                tracks: list[MetadataHint] = []
                for tr in tracks_raw[:50]:
                    t_title = _clean_text(tr.get("title") or "")
                    t_art = _clean_artist((tr.get("artist") or {}).get("name") or "")
                    dur = int(tr["duration"]) if tr.get("duration") else None
                    if t_title:
                        tracks.append(MetadataHint(title=t_title, artist=t_art, duration=dur, thumbnail_url=cover))
                if tracks:
                    return alb_title, tracks
            except Exception:
                logger.debug("Не удалось распарсить альбом Deezer %s", url, exc_info=True)

    if platform == "apple":
        m = re.search(r"/album/[^/]+/(\d+)", path) or re.search(r"/album/(\d+)", path)
        if m:
            collection_id = m.group(1)
            try:
                _, text = _http_get_text(
                    f"https://itunes.apple.com/lookup?id={collection_id}&entity=song&country=RU",
                    timeout=10,
                )
                data = json.loads(text)
                results = data.get("results") or []
                alb_title = "Альбом"
                tracks = []
                for item in results:
                    if item.get("wrapperType") == "collection":
                        alb_title = _clean_text(item.get("collectionName") or alb_title)
                    elif item.get("wrapperType") == "track" and item.get("trackName"):
                        t_title = _clean_text(item["trackName"])
                        t_art = _clean_artist(item.get("artistName") or "")
                        dur_ms = item.get("trackTimeMillis")
                        dur = int(round(dur_ms / 1000)) if isinstance(dur_ms, (int, float)) else None
                        thumb = item.get("artworkUrl100")
                        if thumb:
                            thumb = re.sub(r"\d+x\d+bb", "600x600bb", thumb)
                        tracks.append(MetadataHint(title=t_title, artist=t_art, duration=dur, thumbnail_url=thumb))
                if tracks:
                    return alb_title, tracks
            except Exception:
                logger.debug("Не удалось распарсить альбом Apple Music %s", url, exc_info=True)

    if platform == "yandex":
        m = re.search(r"/album/(\d+)", path)
        if m:
            alb_id = m.group(1)
            try:
                api_url = f"https://music.yandex.ru/handlers/album.jsx?album={alb_id}"
                _, text = _http_get_text(api_url, timeout=10, user_agent=BOT_USER_AGENT)
                data = json.loads(text)
                alb_title = _clean_text(data.get("title") or "Альбом")
                alb_art = _clean_artist(", ".join(a.get("name", "") for a in (data.get("artists") or []) if a.get("name")))
                cover_uri = data.get("coverUri")
                cover = f"https://{cover_uri.replace('%%', '400x400')}" if cover_uri else None
                tracks = []
                for vol in (data.get("volumes") or []):
                    for tr in vol:
                        t_title = _clean_text(tr.get("title") or "")
                        t_art = _clean_artist(", ".join(a.get("name", "") for a in (tr.get("artists") or []) if a.get("name"))) or alb_art
                        dur_ms = tr.get("durationMs")
                        dur = int(round(dur_ms / 1000)) if isinstance(dur_ms, (int, float)) else None
                        if t_title:
                            tracks.append(MetadataHint(title=t_title, artist=t_art, duration=dur, thumbnail_url=cover))
                if tracks:
                    return alb_title, tracks[:50]
            except Exception:
                logger.debug("Ошибка парсинга альбома Яндекс Музыки %s", url, exc_info=True)

    try:
        _, html_text = _http_get_text(url, timeout=10, user_agent=BOT_USER_AGENT)
        og_title = _extract_meta_tag(html_text, "og:title") or ""
        art, alb_title = _clean_apple_title(og_title) if platform == "apple" else _split_artist_title(og_title)
        if alb_title and not _is_garbage_text(alb_title):
            deezer_tracks = _search_deezer_album_tracks(art, alb_title)
            if deezer_tracks:
                return alb_title, deezer_tracks
    except Exception:
        pass

    return "", []

def extract_metadata_hint(url: str, platform: str) -> MetadataHint | None:
    if platform not in METADATA_FIRST_PLATFORMS:
        return None

    parsed = urlparse(url)
    path = parsed.path or ""
    query = parse_qs(parsed.query)

    if platform == "yandex":
        m = re.search(r"/track/(\d+)", path)
        if m:
            track_id = m.group(1)
            try:
                api_url = f"https://music.yandex.ru/handlers/track.jsx?track={track_id}"
                _, text = _http_get_text(api_url, timeout=8, user_agent=BOT_USER_AGENT)
                data = json.loads(text).get("track") or {}
                title = _clean_text(data.get("title") or "")
                version = _clean_text(data.get("version") or "")
                if version and version.lower() not in title.lower():
                    title = f"{title} ({version})"
                artists = [a.get("name", "") for a in (data.get("artists") or []) if a.get("name")]
                artist = _clean_artist(", ".join(artists))
                dur_ms = data.get("durationMs")
                dur = int(round(dur_ms / 1000)) if isinstance(dur_ms, (int, float)) else None
                cover_uri = data.get("coverUri") or ((data.get("ogImage") or ""))
                thumb = f"https://{cover_uri.replace('%%', '400x400')}" if cover_uri else None
                if title and not _is_garbage_text(title):
                    return _enrich_hint_from_catalogs(MetadataHint(title=title, artist=artist, duration=dur, thumbnail_url=thumb))
            except Exception:
                logger.debug("track.jsx не сработал для %s", url, exc_info=True)

    if platform == "apple":
        track_id = (query.get("i") or [None])[0]
        if track_id and str(track_id).isdigit():
            try:
                _, text = _http_get_text(f"https://itunes.apple.com/lookup?id={track_id}&country=RU", timeout=8)
                results = json.loads(text).get("results") or []
                for item in results:
                    if item.get("wrapperType") == "track" and item.get("trackName"):
                        title = _clean_text(item["trackName"])
                        artist = _clean_artist(item.get("artistName") or "")
                        dur_ms = item.get("trackTimeMillis")
                        dur = int(round(dur_ms / 1000)) if isinstance(dur_ms, (int, float)) else None
                        thumb = item.get("artworkUrl100")
                        if thumb:
                            thumb = re.sub(r"\d+x\d+bb", "600x600bb", thumb)
                        return MetadataHint(title=title, artist=artist, duration=dur, thumbnail_url=thumb)
            except Exception:
                pass

    if platform == "deezer":
        m = re.search(r"/track/(\d+)", path)
        if m:
            try:
                _, text = _http_get_text(f"https://api.deezer.com/track/{m.group(1)}", timeout=8)
                data = json.loads(text)
                title = _clean_text(data.get("title") or "")
                artist = _clean_artist((data.get("artist") or {}).get("name") or "")
                dur = int(data["duration"]) if data.get("duration") else None
                thumb = (data.get("album") or {}).get("cover_xl") or (data.get("album") or {}).get("cover_big")
                if title and not _is_garbage_text(title):
                    return MetadataHint(title=title, artist=artist, duration=dur, thumbnail_url=thumb)
            except Exception:
                pass

    odesli_hint = _extract_odesli_metadata(url)
    if odesli_hint:
        return _enrich_hint_from_catalogs(odesli_hint)

    try:
        _, html_text = _http_get_text(url, timeout=10, user_agent=BOT_USER_AGENT)
        og_title = _extract_meta_tag(html_text, "og:title") or _extract_meta_tag(html_text, "twitter:title") or ""
        og_desc = _extract_meta_tag(html_text, "og:description") or ""
        og_image = _extract_meta_tag(html_text, "og:image")
        if og_title and not _is_garbage_text(og_title):
            if platform == "apple":
                art, tit = _clean_apple_title(og_title)
            else:
                art, tit = _split_artist_title(og_title)
            if not art and og_desc and not _is_garbage_text(og_desc):
                cand_art = _clean_artist(og_desc.split("•")[0].split("·")[0].split("—")[0])
                if len(cand_art) <= 45:
                    art = cand_art
            if tit and not _is_garbage_text(tit):
                return _enrich_hint_from_catalogs(MetadataHint(title=tit, artist=art, thumbnail_url=og_image))
    except Exception:
        logger.debug("HTML-парсинг метаданных не удался для %s", url, exc_info=True)

    return None


# --- ПОДГОТОВКА КВАДРАТНОЙ ОБЛОЖКИ ЧЕРЕЗ PILLOW ---
def prepare_thumbnail(thumb_source: str | Path | None, target_path: Path, size: int = 600) -> Path | None:
    if not thumb_source:
        return None
    raw_file = target_path.with_suffix(".raw_thumb")
    try:
        if isinstance(thumb_source, Path) or os.path.exists(str(thumb_source)):
            shutil.copy2(str(thumb_source), raw_file)
        elif str(thumb_source).startswith(("http://", "https://")):
            req = urllib.request.Request(str(thumb_source), headers={"User-Agent": USER_AGENT})
            with _build_opener().open(req, timeout=10) as resp:
                raw_file.write_bytes(resp.read(5 * 1024 * 1024))
        else:
            return None

        with PILImage.open(raw_file) as img:
            img = img.convert("RGB")
            square = ImageOps.fit(img, (size, size), method=PILImage.Resampling.LANCZOS)
            square.save(target_path, format="JPEG", quality=90, optimize=True)
        return target_path if target_path.exists() else None
    except Exception:
        logger.debug("Не удалось подготовить обложку %s", thumb_source, exc_info=True)
        return None
    finally:
        if raw_file.exists():
            try:
                raw_file.unlink()
            except OSError:
                pass


# --- СКАЧИВАНИЕ И ПОИСК ЧЕРЕЗ YT-DLP ---
def _base_ydl_opts() -> dict:
    opts: dict = {
        "quiet": True,
        "no_warnings": True,
        "noplaylist": True,
        "geo_bypass": True,
        "http_headers": {"User-Agent": USER_AGENT},
        "socket_timeout": 20,
        "retries": 3,
    }
    if YTDLP_PROXY:
        opts["proxy"] = YTDLP_PROXY
    if COOKIES_FILE.is_file():
        opts["cookiefile"] = str(COOKIES_FILE)
    return opts

def ytdlp_search_tracks(query: str, limit: int = 18, target_duration: int | None = None) -> list[dict]:
    opts = _base_ydl_opts()
    opts["extract_flat"] = True
    results: list[dict] = []
    try:
        with yt_dlp.YoutubeDL(opts) as ydl:
            info = ydl.extract_info(f"ytsearch{limit}:{query}", download=False)
            entries = (info or {}).get("entries") or []
            for e in entries:
                if not isinstance(e, dict) or not e.get("id"):
                    continue
                dur = e.get("duration")
                if dur and dur > MAX_TRACK_SECONDS:
                    continue
                raw_t = _clean_text(e.get("title") or "")
                raw_u = _clean_artist(e.get("uploader") or e.get("channel") or "")
                norm_title, norm_artist = _normalize_track_and_artist(raw_t, raw_u)
                url = e.get("url") or f"https://www.youtube.com/watch?v={e['id']}"
                results.append({
                    "id": e["id"],
                    "title": norm_title or "Трек",
                    "uploader": norm_artist,
                    "duration": int(dur) if dur else None,
                    "url": canonical_youtube_url(url),
                })
    except Exception:
        logger.warning("Ошибка поиска yt-dlp для '%s'", query, exc_info=True)

    if target_duration and results:
        results.sort(key=lambda x: abs((x.get("duration") or target_duration) - target_duration))
    return results

def ytdlp_download_audio(
    target_url_or_query: str,
    out_base: Path,
    bitrate: str,
    hint: MetadataHint | None = None,
) -> tuple[Path, str, str, int | None, Path | None, str | None]:
    opts = _base_ydl_opts()
    opts["format"] = "bestaudio/best"
    opts["outtmpl"] = str(out_base) + ".%(ext)s"
    opts["writethumbnail"] = True

    if shutil.which("ffmpeg"):
        opts["postprocessors"] = [{
            "key": "FFmpegExtractAudio",
            "preferredcodec": "mp3",
            "preferredquality": str(bitrate),
        }]

    with yt_dlp.YoutubeDL(opts) as ydl:
        info = ydl.extract_info(target_url_or_query, download=True)
        if "entries" in info and info["entries"]:
            info = info["entries"][0]

    dur = int(info.get("duration")) if info.get("duration") else (hint.duration if hint else None)
    if dur and dur > MAX_TRACK_SECONDS:
        raise ValueError("Трек превышает максимальную длительность (90 минут).")

    info_track = _clean_text(info.get("track") or "")
    info_title = _clean_text(info.get("title") or "")
    info_artist = (
        _clean_artist(info.get("artist") or "")
        or _clean_artist(info.get("creator") or "")
        or _clean_artist(info.get("uploader") or "")
        or _clean_artist(info.get("channel") or "")
    )

    if hint and hint.title and not _is_garbage_text(hint.title):
        raw_title = hint.title
        raw_artist = hint.artist if (hint.artist and not _is_garbage_text(hint.artist)) else info_artist
    else:
        raw_title = info_track or info_title or "Track"
        raw_artist = info_artist

    clean_title, clean_artist = _normalize_track_and_artist(raw_title, raw_artist)

    if not clean_artist and clean_title and clean_title != "Track":
        enriched = _enrich_hint_from_catalogs(MetadataHint(title=clean_title, artist=""))
        if enriched.artist:
            clean_artist = enriched.artist

    vid_id = info.get("id") if info.get("extractor_key", "").lower() in ("youtube", "soundcloud") else extract_youtube_id(target_url_or_query)

    audio_path = out_base.with_suffix(".mp3")
    if not audio_path.exists():
        candidates = [p for p in out_base.parent.glob(f"{out_base.name}.*") if p.suffix.lower() not in (".jpg", ".jpeg", ".png", ".webp", ".part")]
        if not candidates:
            raise FileNotFoundError("Аудиофайл не найден после загрузки.")
        audio_path = candidates[0]

    thumb_target = out_base.with_suffix(".cover.jpg")
    thumb_source: str | Path | None = hint.thumbnail_url if (hint and hint.thumbnail_url) else None
    if not thumb_source:
        for ext in (".webp", ".jpg", ".jpeg", ".png"):
            cand_thumb = out_base.with_suffix(ext)
            if cand_thumb.exists():
                thumb_source = cand_thumb
                break
        if not thumb_source and info.get("thumbnail"):
            thumb_source = info.get("thumbnail")

    final_thumb = prepare_thumbnail(thumb_source, thumb_target, size=320)

    for ext in (".webp", ".jpg", ".jpeg", ".png"):
        p = out_base.with_suffix(ext)
        if p.exists() and p != final_thumb:
            try:
                p.unlink()
            except OSError:
                pass

    return audio_path, clean_title or "Track", clean_artist or "Неизвестен", dur, final_thumb, vid_id


# --- ФУНКЦИИ ЧТЕНИЯ И ЗАПИСИ ТЕГОВ / ОБЛОЖКИ В АУДИОФАЙЛЫ ЧЕРЕЗ FFMPEG ---
def probe_audio_metadata(audio_path: Path, extract_cover_to: Path | None = None) -> tuple[str, str, int | None, Path | None]:
    """Извлекает (title, artist, duration, cover_path) из любого аудиофайла через ffprobe и ffmpeg."""
    title, artist, dur = "", "", None
    if shutil.which("ffprobe"):
        try:
            cmd = [
                "ffprobe", "-v", "quiet",
                "-print_format", "json",
                "-show_format",
                str(audio_path),
            ]
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
            if proc.returncode == 0 and proc.stdout:
                data = json.loads(proc.stdout)
                fmt = data.get("format") or {}
                if fmt.get("duration"):
                    dur = int(round(float(fmt["duration"])))
                tags = {k.lower(): v for k, v in (fmt.get("tags") or {}).items()}
                title = _clean_text(tags.get("title") or "")
                artist = _clean_artist(tags.get("artist") or tags.get("album_artist") or tags.get("performer") or "")
        except Exception:
            logger.debug("Ошибка чтения тегов через ffprobe", exc_info=True)

    extracted_cover = None
    if extract_cover_to and shutil.which("ffmpeg"):
        raw_cov = extract_cover_to.with_suffix(".raw_emb.jpg")
        try:
            cmd_cov = [
                "ffmpeg", "-y", "-i", str(audio_path),
                "-an", "-vcodec", "mjpeg", "-frames:v", "1",
                str(raw_cov),
            ]
            subprocess.run(cmd_cov, capture_output=True, timeout=15)
            if raw_cov.exists() and raw_cov.stat().st_size > 200:
                extracted_cover = prepare_thumbnail(raw_cov, extract_cover_to, size=600)
        except Exception:
            pass
        finally:
            if raw_cov.exists():
                try:
                    raw_cov.unlink()
                except OSError:
                    pass

    return title, artist, dur, extracted_cover

def build_tagged_mp3(
    source_path: Path,
    output_mp3: Path,
    title: str,
    artist: str,
    cover_path: Path | None,
    bitrate: str,
) -> Path:
    is_already_mp3 = source_path.suffix.lower() == ".mp3"
    cmd = ["ffmpeg", "-y", "-i", str(source_path)]

    if cover_path and cover_path.exists():
        cmd += ["-i", str(cover_path), "-map", "0:a:0", "-map", "1:v:0"]
    else:
        cmd += ["-map", "0:a:0", "-vn"]

    if is_already_mp3:
        cmd += ["-c:a", "copy"]
    else:
        cmd += ["-acodec", "libmp3lame", "-b:a", f"{bitrate}k"]

    if cover_path and cover_path.exists():
        cmd += [
            "-c:v", "mjpeg",
            "-id3v2_version", "3",
            "-metadata:s:v", "title=Album cover",
            "-metadata:s:v", "comment=Cover (front)",
            "-disposition:v:0", "attached_pic",
        ]
    else:
        cmd += ["-id3v2_version", "3"]

    cmd += [
        "-map_metadata", "-1",
        "-metadata", f"title={title}",
        "-metadata", f"artist={artist}",
        str(output_mp3),
    ]

    proc = subprocess.run(cmd, capture_output=True, timeout=180)
    if proc.returncode != 0 or not output_mp3.exists():
        cmd_fallback = ["ffmpeg", "-y", "-i", str(source_path)]
        if cover_path and cover_path.exists():
            cmd_fallback += ["-i", str(cover_path), "-map", "0:a:0", "-map", "1:v:0", "-c:v", "mjpeg", "-disposition:v:0", "attached_pic"]
        else:
            cmd_fallback += ["-map", "0:a:0", "-vn"]
        cmd_fallback += [
            "-acodec", "libmp3lame", "-b:a", f"{bitrate}k",
            "-id3v2_version", "3",
            "-map_metadata", "-1",
            "-metadata", f"title={title}",
            "-metadata", f"artist={artist}",
            str(output_mp3),
        ]
        proc2 = subprocess.run(cmd_fallback, capture_output=True, timeout=180)
        if proc2.returncode != 0 or not output_mp3.exists():
            raise RuntimeError("Ошибка сборки MP3 через FFmpeg.")

    return output_mp3


