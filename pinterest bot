@dp.callback_query(F.data.startswith("ed:"))
async def cb_audio_editor_actions(call: types.CallbackQuery, state: FSMContext):
    user = call.from_user
    sess = audio_edit_sessions.get(user.id)
    action = call.data.split(":", 1)[1]

    if action == "cancel":
        await state.clear()
        cleanup_audio_edit_session(user.id)
        await call.answer("Редактирование отменено")
        try:
            await call.message.delete()
        except Exception:
            pass
        return

    if not sess or not sess.source_path.exists():
        await state.clear()
        await call.answer("⚠️ Сессия редактора устарела. Отправь аудиофайл заново!", show_alert=True)
        return

    if action == "open_from_voice":
        await state.set_state(AudioEditStates.editing)
        await call.answer()
        try:
            await call.message.delete()
        except Exception:
            pass
        await render_editor_panel(sess)
        return

    if action == "shazam":
        await call.answer("🔍 Распознаю песню через Shazam...")
        await render_editor_panel(sess, prompt_note="⏳ <i>Анализирую аудио через Shazam...</i>")
        hint, _, _ = await recognize_audio_smart(sess.source_path)
        if hint and hint.title:
            sess.title = hint.title[:64]
            if hint.artist:
                sess.artist = hint.artist[:64]
            if hint.thumbnail_url:
                new_cov = DOWNLOAD_DIR / f"shzcov_{user.id}_{uuid.uuid4().hex[:6]}.jpg"
                prep = await asyncio.to_thread(prepare_thumbnail, hint.thumbnail_url, new_cov, 600)
                if prep and prep.exists():
                    if sess.cover_path and sess.cover_path.exists():
                        try:
                            sess.cover_path.unlink()
                        except OSError:
                            pass
                    sess.cover_path = prep
            await render_editor_panel(
                sess,
                prompt_note=(
                    f"🎉 <b>Распознано: {html.escape(sess.artist)} — {html.escape(sess.title)}!</b>\n"
                    f"<i>Теги и обложка автоматически подставлены. Нажми «Сохранить и получить MP3»!</i>"
                ),
            )
        else:
            await render_editor_panel(sess, prompt_note="😔 <i>Shazam не нашёл точного совпадения для этого файла.</i>")
        return

    if action == "title":
        await state.set_state(AudioEditStates.waiting_title)
        await call.answer()
        await render_editor_panel(
            sess,
            prompt_note="✏️ <b>Введи новое название трека</b> и отправь его в чат:",
        )
    elif action == "artist":
