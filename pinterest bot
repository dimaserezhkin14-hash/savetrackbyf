    _, session_id, page_str = call.data.split(":")
    sess = search_sessions.get(session_id)
    if not sess:
        return await call.answer("⚠️ Результаты поиска устарели, введи запрос заново.", show_alert=True)

    page = int(page_str)
    await call.answer()
    await call.message.edit_reply_markup(reply_markup=build_search_keyboard(session_id, page=page))

@dp.callback_query(F.data.startswith("dl:"))
async def cb_download_from_search(call: types.CallbackQuery):
    _, session_id, idx_str = call.data.split(":")
    sess = search_sessions.get(session_id)
    if not sess:
        return await call.answer("⚠️ Кнопка устарела, введи запрос заново.", show_alert=True)

    items: list[dict] = sess.get("items") or []
    idx = int(idx_str)
    if idx < 0 or idx >= len(items):
        return await call.answer("Трек не найден.", show_alert=True)

    item = items[idx]
    await call.answer("⏳ Начинаю загрузку...")
    wait_msg = await call.message.answer(f"⏳ Скачиваю: <b>{html.escape(item.get('title', 'Трек'))}</b>...", parse_mode="HTML")

    norm_title, norm_artist = _normalize_track_and_artist(item.get("title") or "", item.get("uploader") or "")
    hint = MetadataHint(
        title=norm_title or "Track",
        artist=norm_artist,
        duration=item.get("duration"),
    )
    hint = await asyncio.to_thread(_enrich_hint_from_catalogs, hint)
    await download_and_send_single(call.message, call.from_user, item["url"], status_msg=wait_msg, hint=hint)


