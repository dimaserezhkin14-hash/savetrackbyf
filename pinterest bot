@dp.message(F.video | F.video_note | F.document.mime_type.startswith("video/"))
async def handle_video_to_mp3(message: types.Message):
    if message.chat.id == LOG_GROUP_ID:
        return

    user = message.from_user
    register_user(user.id, username=user.username)

    media = message.video or message.video_note or message.document
    if media.file_size and media.file_size > TG_VIDEO_DL_LIMIT:
        return await message.reply(
            "⚠️ <b>Видео слишком большое!</b>\n"
            "Telegram разрешает ботам скачивать видеофайлы напрямую размером до <b>20 МБ</b>.\n"
            "Если это ролик с YouTube, TikTok или Instagram — просто пришли мне <b>ссылку</b> на него!",
            parse_mode="HTML",
        )

    status_msg = await message.reply("⏳ Извлекаю звук из видео в MP3 и распознаю трек через Shazam...")
    uid_tag = f"{user.id}_{uuid.uuid4().hex[:8]}"
    video_path = DOWNLOAD_DIR / f"vid_{uid_tag}.mp4"
    mp3_path = DOWNLOAD_DIR / f"vid_{uid_tag}.mp3"
    raw_frame_path = DOWNLOAD_DIR / f"frame_{uid_tag}.jpg"
    cover_path = DOWNLOAD_DIR / f"cover_{uid_tag}.jpg"

    try:
        async with download_semaphore:
            await bot.download(media, destination=video_path)
            bitrate = get_user_bitrate(user.id)

            cmd_audio = [
                "ffmpeg", "-y", "-i", str(video_path),
                "-vn", "-acodec", "libmp3lame", "-b:a", f"{bitrate}k",
                str(mp3_path),
            ]
            proc = await asyncio.to_thread(subprocess.run, cmd_audio, capture_output=True)
            if proc.returncode != 0 or not mp3_path.exists():
                raise RuntimeError("Не удалось извлечь аудиодорожку из видео.")

            cmd_frame = [
                "ffmpeg", "-y", "-ss", "00:00:01", "-i", str(video_path),
                "-frames:v", "1", "-q:v", "2", str(raw_frame_path),
            ]
            await asyncio.to_thread(subprocess.run, cmd_frame, capture_output=True)
            final_thumb = await asyncio.to_thread(
                prepare_thumbnail,
                raw_frame_path if raw_frame_path.exists() else None,
                cover_path,
                320,
            )

        # Параллельно пробиваем звук из видео через наш умный Shazam
        shz_hint, _, _ = await recognize_audio_smart(mp3_path)

        raw_caption = _clean_text(message.caption or "")
        orig_name = getattr(media, "file_name", "") or ""
        if orig_name:
            orig_name = _clean_text(Path(orig_name).stem)

        if shz_hint and shz_hint.title:
            title = shz_hint.title
            artist = shz_hint.artist or user.first_name or "Видео"
        else:
            title = raw_caption or orig_name or "Аудио из видео"
            artist = user.first_name or "Видео"
            art_split, tit_split = _split_artist_title(title)
            if art_split and tit_split:
                artist, title = art_split, tit_split

        reply_kb = None
        if shz_hint and shz_hint.title:
            q_key = uuid.uuid4().hex[:8]
            shazam_quick_cache[q_key] = shz_hint
            kb = InlineKeyboardBuilder()
            kb.row(
                types.InlineKeyboardButton(
                    text=f"⬇️ Скачать полный трек: {shz_hint.search_query[:38]}",
                    callback_data=f"shzdl:{q_key}",
                )
            )
            reply_kb = kb.as_markup()

        await message.reply_audio(
            audio=types.FSInputFile(mp3_path, filename=f"{title[:50]}.mp3"),
            title=title[:64],
            performer=artist[:64],
            thumbnail=types.FSInputFile(final_thumb) if final_thumb else None,
            caption=get_mp3_caption(user.id),
            parse_mode="HTML",
            reply_markup=reply_kb,
        )
        await status_msg.delete()
        await send_log(
            f"🎬 <b>Видео ➡️ MP3 ({bitrate} kbps):</b> {html.escape(artist)} — {html.escape(title)}\n"
            f"• Юзер: @{user.username or 'нет'} (<code>{user.id}</code>)"
        )
    except Exception as exc:
        logger.warning("Ошибка конвертации видео в MP3: %s", exc, exc_info=True)
        await status_msg.edit_text("❌ Не удалось извлечь звук из этого видео (возможно, в нем нет аудиодорожки).")
    finally:
        for p in (video_path, mp3_path, raw_frame_path, cover_path):
            if p.exists():
                try:
                    p.unlink()
                except OSError:
                    pass

