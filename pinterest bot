@dp.message(F.text)
async def handle_text_or_url(message: types.Message, state: FSMContext):
    if message.chat.id == LOG_GROUP_ID:
        return

    cur_state = await state.get_state()
    if cur_state == AudioEditStates.editing.state:
        await state.clear()
        cleanup_audio_edit_session(message.from_user.id)

    user = message.from_user
    register_user(user.id, username=user.username)
    raw_text = (message.text or "").strip()

    if raw_text.lower().startswith(f"@{BOT_USERNAME.lower()}"):
        raw_text = raw_text[len(BOT_USERNAME) + 1:].strip()

    if is_vk_url(raw_text):
        return await message.reply(
            "⚠️ Ссылки на ВК не поддерживаются.\n"
            "Просто напиши мне <b>название песни или исполнителя</b> текстом, и я найду её в высоком качестве!",
            parse_mode="HTML",
        )

    candidates = collect_candidate_urls(message)
    url, platform = find_supported_url(candidates)

    # 1. Если прислали ссылку
    if url and platform:
        status_msg = await message.reply("⏳ Обрабатываю ссылку...")
        resolved_url = await asyncio.to_thread(resolve_short_url, url)
        res_classified = classify_url(resolved_url)
        if res_classified:
            url, platform = res_classified

        if is_album_or_playlist_url(url, platform):
            if not is_pro_user(user.id):
                ref_link = get_ref_link(user.id)
                return await status_msg.edit_text(
                    f"🔒 <b>Скачивание альбомов и плейлистов целиком доступно в PRO-режиме!</b>\n\n"
                    f"Пригласи всего <b>{PRO_REQUIRED_REFS} друга</b> (перешли ему любой скачанный трек или отправь свою ссылку), "
                    f"чтобы открыть скачивание альбомов и максимальное качество <b>320 kbps</b>:\n\n"
                    f"<code>{ref_link}</code>",
                    parse_mode="HTML",
                )

            alb_key = (user.id, url)
            if alb_key in active_album_downloads:
                return await status_msg.edit_text("⏳ Этот альбом уже скачивается для тебя, подожди немного!")

            active_album_downloads.add(alb_key)
            try:
                alb_title, tracks = await asyncio.to_thread(extract_album_tracks, url, platform)
                if not tracks:
                    return await status_msg.edit_text("😔 Не удалось получить список треков альбома. Попробуй скинуть ссылку на конкретный трек.")

                await status_msg.edit_text(
                    f"💿 <b>Альбом «{html.escape(alb_title)}»</b>\n"
                    f"Найдено треков: <b>{len(tracks)}</b>. Начинаю загрузку...",
                    parse_mode="HTML",
                )
                for idx, tr_hint in enumerate(tracks[:25], start=1):
                    try:
                        await status_msg.edit_text(
                            f"💿 Скачиваю трек <b>{idx}/{min(len(tracks), 25)}</b>:\n"
                            f"🎵 {html.escape(tr_hint.search_query)}",
                            parse_mode="HTML",
                        )
                    except Exception:
                        pass
                    await download_and_send_single(message, user, f"ytsearch1:{tr_hint.search_query}", status_msg=None, hint=tr_hint)
                await status_msg.edit_text(f"✅ Загрузка альбома <b>«{html.escape(alb_title)}»</b> завершена!", parse_mode="HTML")
            finally:
                active_album_downloads.discard(alb_key)
            return

        hint = await asyncio.to_thread(extract_metadata_hint, url, platform)
        if not hint and platform in METADATA_FIRST_PLATFORMS:
            hint = extract_message_context_hint(message, url)

        if platform in METADATA_FIRST_PLATFORMS:
            if not hint or not hint.title:
                return await status_msg.edit_text(
                    "😔 Не удалось распознать название трека по этой ссылке. Напиши исполнителя и название песни текстом!"
                )
            target_q = hint.direct_urls[0] if hint.direct_urls else f"ytsearch1:{hint.search_query}"
            await status_msg.edit_text(f"⏳ Скачиваю: <b>{html.escape(hint.search_query)}</b>...", parse_mode="HTML")
            await download_and_send_single(message, user, target_q, status_msg=status_msg, hint=hint)
        else:
            await status_msg.edit_text("⏳ Загружаю аудио и конвертирую в MP3...")
            target_u = canonical_youtube_url(url) if platform == "youtube" else url
            ok = await download_and_send_single(message, user, target_u, status_msg=status_msg, hint=None)
            if not ok:
                ctx_hint = extract_message_context_hint(message, url)
                if ctx_hint and ctx_hint.title:
                    await download_and_send_single(message, user, f"ytsearch1:{ctx_hint.search_query}", status_msg=None, hint=ctx_hint)
        return

    # 2. Текстовый поиск песни
    query = _clean_text(raw_text)
    if len(query) < 2:
        return await message.reply("Напиши название песни, имя артиста или отправь голосовое / ссылку / видео / аудиофайл!")

    status_msg = await message.reply(f"🔎 Ищу: <b>{html.escape(query)}</b>...", parse_mode="HTML")
    results = await asyncio.to_thread(ytdlp_search_tracks, query, 18)

    if not results:
        return await status_msg.edit_text("😔 По твоему запросу ничего не найдено. Попробуй написать иначе.")

    session_id = uuid.uuid4().hex[:10]
    search_sessions[session_id] = {
        "user_id": user.id,
        "query": query,
        "items": results,
        "created_at": time.time(),
    }
    if len(search_sessions) > 500:
        cutoff = time.time() - 3600
        for k in [k for k, v in search_sessions.items() if v.get("created_at", 0) < cutoff]:
            search_sessions.pop(k, None)

    kb = build_search_keyboard(session_id, page=0)
    await status_msg.edit_text(
        f"🎶 Результаты по запросу <b>«{html.escape(query)}»</b>:\nВыбери нужный трек для скачивания:",
        parse_mode="HTML",
        reply_markup=kb,
    )
    await send_log(f"🔎 <b>Поиск:</b> <code>{html.escape(query)}</code> | @{user.username or 'нет'} (<code>{user.id}</code>)")


# --- ОБРАБОТКА КНОПОК ПАГИНАЦИИ И СКАЧИВАНИЯ ИЗ ПОИСКА ---
@dp.callback_query(F.data.startswith("page:"))
