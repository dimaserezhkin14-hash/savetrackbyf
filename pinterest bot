def register_user(
    user_id: int,
    referrer_id: int | None = None,
    username: str | None = None,
) -> tuple[bool, int | None]:
    """Регистрирует юзера. Возвращает (is_new_user, credited_referrer_id)."""
    is_new = user_id not in users_db
    credited_referrer = None

    if is_new:
        users_db.add(user_id)
        try:
            save_users()
        except Exception:
            logger.exception("Не удалось сохранить базу пользователей")

        user_rec = _ensure_ref_record(user_id, username=username)
        if (
            referrer_id
            and referrer_id != user_id
            and referrer_id in users_db
            and user_rec.get("referred_by") is None
        ):
            user_rec["referred_by"] = referrer_id
            inviter_rec = _ensure_ref_record(referrer_id)
            if user_id not in inviter_rec["invited"]:
                inviter_rec["invited"].append(user_id)
                credited_referrer = referrer_id
            save_referrals()
        else:
            save_referrals()
    else:
        _ensure_ref_record(user_id, username=username)

    return is_new, credited_referrer


