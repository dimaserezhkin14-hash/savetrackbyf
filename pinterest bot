URL_RE = re.compile(r'(?:https?://)?(?:[a-z0-9-]+\.)+[a-z]{2,}(?:[/?#][^\s<>"\']*)?', re.IGNORECASE)

def _host_in(host: str, domains: tuple[str, ...] | set[str]) -> bool:
    return any(host == d or host.endswith("." + d) for d in domains)

def _is_safe_public_host(host: str) -> bool:
    if not host or "." not in host or host.endswith(".local"):
        return False
    if host in ("localhost", "127.0.0.1", "0.0.0.0"):
        return False
    try:
        ip = ipaddress.ip_address(host)
        return not (ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_reserved)
    except ValueError:
        return True

def is_vk_url(text: str) -> bool:
    for raw in URL_RE.findall(text or ""):
        u = raw if re.match(r"^https?://", raw, re.I) else f"https://{raw}"
        try:
            host = (urlparse(u).hostname or "").lower()
            if _host_in(host, VK_DOMAINS):
                return True
        except Exception:
            pass
    return False

def detect_platform_by_url(url: str) -> str:
    try:
        parsed = urlparse(url)
        host = (parsed.hostname or "").lower()
        path = (parsed.path or "").lower()
    except ValueError:
        return "web"

    for platform, domains in PLATFORM_DOMAINS.items():
        if _host_in(host, domains):
            return platform
    if _host_in(host, ("yandex.ru", "yandex.com", "yandex.by", "yandex.kz")) and "/music" in path:
        return "yandex"
    return "web"

def classify_url(raw: str) -> tuple[str, str] | None:
    url = (raw or "").strip().strip("<>\"'").rstrip(".,!?;:)]}>»…")
    if not url:
        return None
    if not re.match(r"^https?://", url, re.IGNORECASE):
        if "/" not in url and "?" not in url:
            return None
        url = "https://" + url
    try:
        parsed = urlparse(url)
        host = (parsed.hostname or "").lower()
    except ValueError:
        return None
    if not _is_safe_public_host(host) or _host_in(host, VK_DOMAINS):
        return None
    platform = detect_platform_by_url(url)
    if platform != "web" and parsed.path in ("", "/") and not parsed.query:
        return None
    return url, platform

def find_supported_url(candidates: list[str]) -> tuple[str | None, str | None]:
    for raw in candidates:
        result = classify_url(raw)
        if result:
            return result
    return None, None

def collect_candidate_urls(message: types.Message) -> list[str]:
    candidates: list[str] = []
    for text, entities in ((message.text, message.entities), (message.caption, message.caption_entities)):
        if not text:
            continue
        for ent in entities or []:
            try:
                if ent.type == "text_link" and ent.url:
                    candidates.append(ent.url)
                elif ent.type == "url":
                    candidates.append(ent.extract_from(text))
            except Exception:
                pass
        candidates.extend(URL_RE.findall(text))
    return candidates

def _build_opener() -> urllib.request.OpenerDirector:
    cookie_jar = http.cookiejar.CookieJar()
    handlers: list[urllib.request.BaseHandler] = [urllib.request.HTTPCookieProcessor(cookie_jar)]
    if YTDLP_PROXY:
        handlers.append(urllib.request.ProxyHandler({"http": YTDLP_PROXY, "https": YTDLP_PROXY}))
    return urllib.request.build_opener(*handlers)

def _decode_bytes(raw: bytes, content_type: str = "") -> str:
    if not raw:
        return ""
    ct_low = (content_type or "").lower()
    if "windows-1251" in ct_low or "cp1251" in ct_low:
        return raw.decode("cp1251", errors="ignore")
    head_ascii = raw[:4096].decode("latin-1", errors="ignore").lower()
    if "windows-1251" in head_ascii or "cp1251" in head_ascii:
        return raw.decode("cp1251", errors="ignore")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return raw.decode("cp1251", errors="ignore")

def _http_get_text(
    url: str,
    extra_headers: dict[str, str] | None = None,
    max_bytes: int = 2 * 1024 * 1024,
    timeout: int = 12,
    user_agent: str | None = None,
    post_data: bytes | None = None,
) -> tuple[str, str]:
    headers = {
        "User-Agent": user_agent or USER_AGENT,
        "Accept-Language": "ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7",
    }
    if extra_headers:
        headers.update(extra_headers)
    req = urllib.request.Request(url, data=post_data, headers=headers)
    with _build_opener().open(req, timeout=timeout) as resp:
        final_url = resp.geturl()
        ctype = resp.headers.get("Content-Type", "")
        data = resp.read(max_bytes)
    return final_url, _decode_bytes(data, ctype)

def resolve_short_url(url: str) -> str:
    try:
        parsed = urlparse(url)
        host = (parsed.hostname or "").lower()
        if not _host_in(host, SHORT_LINK_HOSTS):
            return url
        final_url, _ = _http_get_text(url, max_bytes=4096, timeout=10)
        if classify_url(final_url):
            return final_url
    except Exception:
        logger.warning("Не удалось раскрыть короткую ссылку %s", url, exc_info=True)
    return url

def extract_youtube_id(url: str) -> str | None:
    try:
        parsed = urlparse(url)
        host = (parsed.hostname or "").lower()
        path = parsed.path or ""
        query = parse_qs(parsed.query)
        video_id = None
        if host == "youtu.be":
            video_id = path.strip("/").split("/")[0]
        elif path == "/watch":
            video_id = (query.get("v") or [None])[0]
        else:
            m = re.match(r"^/(?:shorts|live|embed|v)/([\w-]{11})", path)
            if m:
                video_id = m.group(1)
        if video_id and re.fullmatch(r"[\w-]{11}", video_id):
            return video_id
    except Exception:
        pass
    return None

def canonical_youtube_url(url: str) -> str:
    vid = extract_youtube_id(url)
    return f"https://www.youtube.com/watch?v={vid}" if vid else url


# --- МОДЕЛЬ МЕТАДАННЫХ И СТРИМИНГОВЫЕ ПАРСЕРЫ ---
@dataclass
class MetadataHint:
    title: str
    artist: str = ""
    duration: int | None = None
    thumbnail_url: str | None = None
    direct_urls: list[str] = field(default_factory=list)
    method: str = ""

    @property
    def search_query(self) -> str:
        t = _clean_text(self.title)
        a = _clean_artist(self.artist)
        if a and a.lower() not in t.lower():
            return f"{a} - {t}"
        return t


def _split_artist_title(raw: str) -> tuple[str, str]:
    cleaned = _clean_text(raw)
    for sep in (" — ", " – ", " - ", " | "):
        if sep in cleaned:
            parts = [p.strip() for p in cleaned.split(sep, 1)]
            if len(parts) == 2 and parts[0] and parts[1]:
                art = _clean_artist(parts[0])
                tit = _clean_text(parts[1])
                if art and tit and not _is_garbage_text(tit):
                    return art, tit
    return "", cleaned

def _extract_meta_tag(html_text: str, prop: str) -> str | None:
    patterns = [
        rf'<meta[^>]+(?:property|name)=["\']{re.escape(prop)}["\'][^>]+content=["\']([^"\']+)["\']',
        rf'<meta[^>]+content=["\']([^"\']+)["\'][^>]+(?:property|name)=["\']{re.escape(prop)}["\']',
    ]
    for pat in patterns:
        m = re.search(pat, html_text, re.IGNORECASE)
        if m:
            val = html.unescape(m.group(1)).strip()
            if val:
                return val
    return None

def _extract_odesli_metadata(url: str) -> MetadataHint | None:
    try:
        api_url = f"https://api.song.link/v1-alpha.1/links?url={urllib.parse.quote(url, safe='')}&userCountry=RU"
        _, text = _http_get_text(api_url, timeout=10)
        data = json.loads(text)
        entities = data.get("entitiesByUniqueId") or {}
        links_by_platform = data.get("linksByPlatform") or {}

        direct_urls: list[str] = []
        for plat in ("youtube", "youtubeMusic", "soundcloud"):
            plat_obj = links_by_platform.get(plat)
            if isinstance(plat_obj, dict) and plat_obj.get("url"):
                u = plat_obj["url"]
                if plat in ("youtube", "youtubeMusic"):
                    u = canonical_youtube_url(u)
                if u not in direct_urls:
                    direct_urls.append(u)

        primary_id = data.get("entityUniqueId")
        ordered_entities = []
        if primary_id and primary_id in entities:
            ordered_entities.append(entities[primary_id])
        ordered_entities.extend(v for k, v in entities.items() if k != primary_id and isinstance(v, dict))

        for ent in ordered_entities:
            if ent.get("type") == "album":
                continue
            title = _clean_text(ent.get("title") or "")
            artist = _clean_artist(ent.get("artistName") or "")
            thumb = ent.get("thumbnailUrl")
            if title and not _is_garbage_text(title):
                return MetadataHint(title=title, artist=artist, thumbnail_url=thumb, direct_urls=direct_urls)
    except Exception:
        logger.debug("Odesli не сработал для %s", url, exc_info=True)
    return None

def _search_deezer_catalog(query: str, limit: int = 8) -> list[MetadataHint]:
    results: list[MetadataHint] = []
    if not query or _is_garbage_text(query):
        return results
    try:
        api_url = f"https://api.deezer.com/search?q={urllib.parse.quote(query)}&limit={limit}"
        _, text = _http_get_text(api_url, timeout=8)
        data = json.loads(text)
        for item in (data.get("data") or []):
            if not isinstance(item, dict) or not item.get("title"):
                continue
            title = _clean_text(item["title"])
            artist = _clean_artist((item.get("artist") or {}).get("name") or "")
            dur = int(item["duration"]) if item.get("duration") else None
            album = item.get("album") or {}
            thumb = album.get("cover_xl") or album.get("cover_big") or album.get("cover_medium")
            if title and not _is_garbage_text(title):
                results.append(MetadataHint(title=title, artist=artist, duration=dur, thumbnail_url=thumb))
    except Exception:
        logger.debug("Ошибка поиска в каталоге Deezer: %s", query, exc_info=True)
    return results

def _search_deezer_album_tracks(artist: str, album_title: str) -> list[MetadataHint]:
    q = f"{artist} {album_title}".strip()
    if not q:
        return []
    try:
        api_url = f"https://api.deezer.com/search/album?q={urllib.parse.quote(q)}&limit=5"
        _, text = _http_get_text(api_url, timeout=8)
        data = json.loads(text)
        albums = data.get("data") or []
        alb_norm = _norm_key(album_title)
        art_norm = _norm_key(artist)
        chosen_id = None
        chosen_thumb = None
        chosen_artist = artist

        for a in albums:
            if not isinstance(a, dict) or not a.get("id"):
                continue
            cand_title = _norm_key(a.get("title") or "")
            cand_art = _norm_key((a.get("artist") or {}).get("name") or "")
            if (alb_norm in cand_title or cand_title in alb_norm) and (not art_norm or art_norm in cand_art or cand_art in art_norm):
                chosen_id = a["id"]
                chosen_thumb = a.get("cover_xl") or a.get("cover_big") or a.get("cover_medium")
                chosen_artist = _clean_artist((a.get("artist") or {}).get("name") or artist)
                break
        if not chosen_id and albums and isinstance(albums[0], dict):
            chosen_id = albums[0].get("id")
            chosen_thumb = albums[0].get("cover_xl") or albums[0].get("cover_big")
            chosen_artist = _clean_artist((albums[0].get("artist") or {}).get("name") or artist)

        if chosen_id:
            _, tr_text = _http_get_text(f"https://api.deezer.com/album/{chosen_id}/tracks?limit=50", timeout=8)
            tr_data = json.loads(tr_text)
            tracks: list[MetadataHint] = []
            for item in (tr_data.get("data") or []):
                if not isinstance(item, dict) or not item.get("title"):
                    continue
                t_title = _clean_text(item["title"])
                t_art = _clean_artist((item.get("artist") or {}).get("name") or chosen_artist)
                dur = int(item["duration"]) if item.get("duration") else None
                if t_title and not _is_garbage_text(t_title):
                    tracks.append(MetadataHint(title=t_title, artist=t_art, duration=dur, thumbnail_url=chosen_thumb))
            return tracks
    except Exception:
        logger.debug("Ошибка поиска альбома в Deezer: %s", q, exc_info=True)
    return []

def _search_itunes_catalog(query: str, limit: int = 8, country: str = "RU") -> list[MetadataHint]:
    results: list[MetadataHint] = []
    if not query or _is_garbage_text(query):
        return results
    try:
        api_url = (
            f"https://itunes.apple.com/search?term={urllib.parse.quote(query)}"
            f"&media=music&entity=song&limit={limit}&country={country}"
        )
        _, text = _http_get_text(api_url, timeout=8)
        data = json.loads(text)
        for item in (data.get("results") or []):
            if not isinstance(item, dict) or not item.get("trackName"):
                continue
            title = _clean_text(item["trackName"])
            artist = _clean_artist(item.get("artistName") or "")
            dur_ms = item.get("trackTimeMillis")
            dur = int(round(dur_ms / 1000)) if isinstance(dur_ms, (int, float)) and dur_ms > 0 else None
            thumb = item.get("artworkUrl100")
            if thumb:
                thumb = re.sub(r"\d+x\d+bb", "600x600bb", thumb)
            if title and not _is_garbage_text(title):
                results.append(MetadataHint(title=title, artist=artist, duration=dur, thumbnail_url=thumb))
    except Exception:
        logger.debug("Ошибка поиска в каталоге iTunes: %s", query, exc_info=True)
    return results

def _enrich_hint_from_catalogs(hint: MetadataHint) -> MetadataHint:
    if not hint.title or not hint.artist:
        return hint
    if hint.duration and hint.thumbnail_url:
        return hint

    query = hint.search_query
    candidates = _search_deezer_catalog(query, limit=5) or _search_itunes_catalog(query, limit=5, country="RU")
    if not candidates:
        return hint

    t_norm = _norm_key(hint.title)
    a_norm = _norm_key(hint.artist)
    for c in candidates:
        ct_norm = _norm_key(c.title)
        ca_norm = _norm_key(c.artist)
        if not ct_norm or not ca_norm:
            continue
        title_match = (ct_norm == t_norm or t_norm in ct_norm or ct_norm in t_norm)
        artist_match = (ca_norm == a_norm or a_norm in ca_norm or ca_norm in a_norm)
        if title_match and artist_match:
            if not hint.duration and c.duration:
                hint.duration = c.duration
            if not hint.thumbnail_url and c.thumbnail_url:
                hint.thumbnail_url = c.thumbnail_url
            break
    return hint


