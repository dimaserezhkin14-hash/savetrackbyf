def _is_garbage_text(text: str) -> bool:
    low = (text or "").strip().lower()
    if not low:
        return True
    if not re.search(r"[a-zA-Zа-яА-ЯёЁ0-9]", low):
        return True
    if low in BAD_EXACT_WORDS:
        return True
    if re.fullmatch(r"user[-_]?\d+", low):
        return True
    return any(phrase in low for phrase in BAD_METADATA_PHRASES)

def _clean_text(text: str) -> str:
    if not text:
        return ""
    cleaned = html.unescape(str(text))
    cleaned = cleaned.replace("\xa0", " ").replace("，", ",").replace("؛", ";")
    cleaned = re.sub(r"\s*\|\s*Listen online for free on SoundCloud.*$", "", cleaned, flags=re.I)
    cleaned = re.sub(r"^Stream\s+(.+?)\s+by\s+.+$", r"\1", cleaned, flags=re.I)
    cleaned = re.sub(r"^Play\s+(.+?)\s+and discover followers on SoundCloud.*$", "", cleaned, flags=re.I)
    cleaned = re.sub(r"\s+", " ", cleaned).strip()
    cleaned = re.sub(r"\s*,\s*", ", ", cleaned)
    cleaned = re.sub(r"\s*;\s*", "; ", cleaned)
    return cleaned.strip(" ,;|•·-")

def _clean_artist(name: str) -> str:
    if not name:
        return ""
    cleaned = html.unescape(str(name))
    cleaned = re.sub(r"\s*-\s*Topic$", "", cleaned, flags=re.IGNORECASE).strip()
    cleaned = re.sub(
        r"\s*(?:Official\s+Artist\s+Channel|Official\s+Channel|Official|VEVO|Music)$",
        "",
        cleaned,
        flags=re.IGNORECASE,
    ).strip() or cleaned
    cleaned = re.sub(r"^(?:Альбом|Album|Сингл|Single|EP|Stream|Listen to)\s*[·•:-]?\s*", "", cleaned, flags=re.I).strip()
    cleaned = re.sub(r"\s+on\s+SoundCloud.*$", "", cleaned, flags=re.I).strip()
    cleaned = re.sub(r"^Play\s+.+?\s+and discover.*$", "", cleaned, flags=re.I).strip()
    res = _clean_text(cleaned)
    return "" if _is_garbage_text(res) else res

def _normalize_track_and_artist(raw_title: str, raw_artist: str) -> tuple[str, str]:
    title = _clean_text(raw_title)
    artist = _clean_artist(raw_artist)

    title = re.sub(r"\s*[\(\[](?:Official\s+(?:Audio|Video|Music\s+Video|Lyric\s+Video)|Lyrics?|Audio|HD|HQ|4K)[\)\]]\s*$", "", title, flags=re.I).strip()

    split_art, split_tit = _split_artist_title(title)
    if split_art and split_tit:
        title = split_tit
        if not artist or _norm_key(split_art) != _norm_key(artist):
            artist = split_art

    if _is_garbage_text(artist):
        artist = ""
    if _is_garbage_text(title):
        title = "Track"

    return title, artist

def _clean_apple_title(raw_title: str) -> tuple[str, str]:
    s = _clean_text(raw_title)
    s = re.sub(r"\s+(?:в|on|in)\s+Apple\s*Music.*$", "", s, flags=re.I).strip()
    s = re.sub(r"\s*\|\s*Apple\s*Music.*$", "", s, flags=re.I).strip()

    m_ru = re.search(r"^(?:Альбом|Песня|Сингл|Трек)\s+[«\"](.+?)[»\"]\s*\((.+?)\)", s, re.I)
    if m_ru:
        return _clean_artist(m_ru.group(2)), _clean_text(m_ru.group(1))

    m_ru2 = re.search(r"^[«\"](.+?)[»\"]\s*[—–-]\s*(?:песня|альбом|сингл)?\s*(?:исполнителя\s+)?(.+)$", s, re.I)
    if m_ru2:
        return _clean_artist(m_ru2.group(2)), _clean_text(m_ru2.group(1))

    m_en = re.search(r"^(.+?)\s*(?:-\s*(?:Album|Single|EP|Song)\s+)?by\s+(.+)$", s, re.I)
    if m_en:
        return _clean_artist(m_en.group(2)), _clean_text(m_en.group(1))

    s = re.sub(r"^(?:Альбом|Песня|Сингл|Трек|Album|Song|Single)\s+", "", s, flags=re.I).strip(" «»\"'")
    return _split_artist_title(s)

def _norm_key(text: str) -> str:
    s = (text or "").lower().replace("ё", "е")
    return re.sub(r"[^\wа-яa-z0-9]+", "", s)

def format_duration(seconds: int | None) -> str:
    if not seconds or seconds <= 0:
        return ""
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


