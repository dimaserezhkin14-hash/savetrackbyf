def build_editor_text_and_kb(sess: AudioEditSession, prompt_note: str = "") -> tuple[str, types.InlineKeyboardMarkup]:
    cov_status = "✅ Установлена" if (sess.cover_path and sess.cover_path.exists()) else "❌ Нет (без обложки)"
    dur_str = format_duration(sess.duration) or "—"
    fmt_label = sess.source_ext.lstrip(".").upper() or "AUDIO"
    if fmt_label != "MP3":
        fmt_label = f"{fmt_label} ➡️ MP3 ({get_user_bitrate(sess.user_id)} kbps)"

    text = (
        f"🎛 <b>Редактор трека и обложки</b>\n\n"
        f"🎵 <b>Название:</b> <code>{html.escape(sess.title)}</code>\n"
        f"👤 <b>Автор:</b> <code>{html.escape(sess.artist)}</code>\n"
        f"🖼 <b>Обложка:</b> {cov_status}\n"
        f"⏱ <b>Длительность:</b> {dur_str}  |  📦 <b>Формат:</b> {fmt_label}\n"
    )
    if prompt_note:
        text += f"\n{prompt_note}"
    else:
        text += "\n<i>Выбери действие ниже (можно также распознать этот трек через Shazam!):</i>"

    kb = InlineKeyboardBuilder()
    kb.row(types.InlineKeyboardButton(text="🔍 Распознать песню (Shazam)", callback_data="ed:shazam"))
    kb.row(
        types.InlineKeyboardButton(text="✏️ Изменить название", callback_data="ed:title"),
        types.InlineKeyboardButton(text="👤 Изменить автора", callback_data="ed:artist"),
    )
    if sess.cover_path and sess.cover_path.exists():
        kb.row(
            types.InlineKeyboardButton(text="🖼 Заменить обложку", callback_data="ed:cover"),
            types.InlineKeyboardButton(text="🗑 Удалить обложку", callback_data="ed:del_cover"),
        )
    else:
        kb.row(types.InlineKeyboardButton(text="🖼 Добавить обложку", callback_data="ed:cover"))

    kb.row(types.InlineKeyboardButton(text="✅ Сохранить и получить MP3", callback_data="ed:save"))
    kb.row(types.InlineKeyboardButton(text="✖️ Отмена", callback_data="ed:cancel"))
    return text, kb.as_markup()

async def render_editor_panel(sess: AudioEditSession, prompt_note: str = "", force_new: bool = False) -> None:
    text, markup = build_editor_text_and_kb(sess, prompt_note=prompt_note)
    has_cover = bool(sess.cover_path and sess.cover_path.exists())

    if sess.panel_msg_id and not force_new and (sess.panel_has_photo == has_cover):
        try:
            if has_cover:
                await bot.edit_message_media(
                    chat_id=sess.chat_id,
                    message_id=sess.panel_msg_id,
                    media=types.InputMediaPhoto(
                        media=types.FSInputFile(sess.cover_path),
                        caption=text,
                        parse_mode="HTML",
                    ),
                    reply_markup=markup,
                )
            else:
                await bot.edit_message_text(
                    chat_id=sess.chat_id,
                    message_id=sess.panel_msg_id,
                    text=text,
                    parse_mode="HTML",
                    reply_markup=markup,
                )
            return
        except Exception:
            pass

    if sess.panel_msg_id:
        try:
            await bot.delete_message(sess.chat_id, sess.panel_msg_id)
        except Exception:
            pass

    if has_cover:
        sent = await bot.send_photo(
            chat_id=sess.chat_id,
            photo=types.FSInputFile(sess.cover_path),
            caption=text,
            parse_mode="HTML",
            reply_markup=markup,
        )
        sess.panel_has_photo = True
    else:
        sent = await bot.send_message(
            chat_id=sess.chat_id,
            text=text,
            parse_mode="HTML",
            reply_markup=markup,
        )
        sess.panel_has_photo = False

    sess.panel_msg_id = sent.message_id


