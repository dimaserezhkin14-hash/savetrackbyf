# --- ОТПРАВКА ОДИНОЧНОГО ТРЕКА ---
async def download_and_send_single(
    message: types.Message,
    user: types.User,
    target_url_or_query: str,
    status_msg: types.Message | None = None,
    hint: MetadataHint | None = None,
) -> bool:
    uid_tag = f"{user.id}_{uuid.uuid4().hex[:8]}"
    out_base = DOWNLOAD_DIR / f"track_{uid_tag}"
    audio_path: Path | None = None
    thumb_path: Path | None = None
    bitrate = get_user_bitrate(user.id)

    try:
        async with download_semaphore:
            audio_path, title, artist, dur, thumb_path, vid_id = await asyncio.to_thread(
                ytdlp_download_audio,
                target_url_or_query,
                out_base,
                bitrate,
                hint,
            )

        if audio_path.stat().st_size > TG_FILE_LIMIT:
            if status_msg:
                await status_msg.edit_text("⚠️ Аудиофайл получился больше 50 МБ — Telegram не пропускает такие файлы.")
            return False

        safe_filename = re.sub(r'[\\/*?:"<>|]', "", f"{artist} - {title}")[:80].strip() or "track"
        sent_msg = await message.answer_audio(
            audio=types.FSInputFile(audio_path, filename=f"{safe_filename}.mp3"),
            title=title[:64],
            performer=artist[:64],
            duration=dur,
            thumbnail=types.FSInputFile(thumb_path) if thumb_path else None,
            caption=get_mp3_caption(user.id),
            parse_mode="HTML",
        )
        if sent_msg.audio and sent_msg.audio.file_id and vid_id:
            cache_track_file_id(vid_id, sent_msg.audio.file_id, title, artist, dur)

        if status_msg:
            try:
                await status_msg.delete()
            except Exception:
                pass

        await send_log(
            f"✅ <b>Скачан трек ({bitrate} kbps):</b> {html.escape(artist)} — {html.escape(title)}\n"
            f"• Юзер: @{user.username or 'нет'} (<code>{user.id}</code>)"
        )
        return True
    except Exception as exc:
        logger.warning("Ошибка скачивания %s: %s", target_url_or_query, exc, exc_info=True)
        if status_msg:
            await status_msg.edit_text(
                "😔 Не удалось скачать этот трек. Попробуй выбрать другую версию из поиска или пришли название текстом."
            )
        await send_log(
            f"⚠️ <b>Ошибка скачивания:</b> <code>{html.escape(target_url_or_query)}</code>\n"
            f"• Юзер: @{user.username or 'нет'} (<code>{user.id}</code>)\n"
            f"• Причина: <code>{html.escape(str(exc)[:200])}</code>"
        )
        return False
    finally:
        for p in (audio_path, thumb_path):
            if p and p.exists():
                try:
                    p.unlink()
                except OSError:
                    pass


